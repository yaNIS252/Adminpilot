# Modèle des variables d'environnement.
#
# Cette liste est alignée sur ce que le code lit réellement : rien de plus,
# rien de moins. Une variable fantôme dans ce fichier finit toujours par être
# renseignée en production « au cas où », et on ne sait plus des mois plus tard
# si elle est vivante ou morte.

# ---------------------------------------------------------------- Supabase
# Projet : adminpilot (eu-west-3 / Paris) — ref cimqqparlgqptvsxrusj
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dashboard > Settings > API. Contourne les policies RLS : serveur uniquement,
# jamais dans une variable préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- IA
# IA : Mistral est le fournisseur principal (mistral-small-latest, escalade
# sur mistral-medium-latest, OCR en repli pour les PDF).
MISTRAL_API_KEY=
# Secours facultatif, utilisé seulement si MISTRAL_API_KEY est absente.
ANTHROPIC_API_KEY=
# "mock" force l'extracteur heuristique, sans appel à l'API. Doit rester vide
# en production : le repli silencieux est interdit, sinon des données simulées
# passeraient pour de vraies détections.
ADMINPILOT_AI_MODE=

# ---------------------------------------------------------------- Ingestion mail
# Domaine des adresses de réception : u-<token>@in.zylax.fr
INBOUND_DOMAIN=
# Signature Svix du webhook Resend `email.received`. 38 caractères.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Emails sortants
RESEND_API_KEY=

# ---------------------------------------------------------------- Paiement
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Les plans sont reconnus par identifiant de tarif, jamais par montant : un
# changement de prix ne doit pas déclasser les abonnés existants.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=

# ---------------------------------------------------------------- Divers
# Base des liens de connexion par email et des retours Stripe. Doit être
# strictement identique à l'URL déclarée dans Supabase > Authentication.
NEXT_PUBLIC_SITE_URL=
# Authentifie les routes /api/cron/*.
CRON_SECRET=

# Suivi des erreurs (facultatif). DSN du projet Sentry, région UE conseillée.
NEXT_PUBLIC_SENTRY_DSN=

# Affiche « Continuer avec Google » une fois le fournisseur configuré dans
# Supabase (client OAuth Google Cloud). Laisser vide sinon.
NEXT_PUBLIC_GOOGLE_AUTH=
